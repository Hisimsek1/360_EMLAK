# Flask Environment Configuration
# Copy this file to .env and fill in your values

# Environment (development, production, testing)
FLASK_ENV=development

# Secret Key for sessions and CSRF (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=dev-secret-key-change-in-production-2024

# Database
# DATA_FILE will be set automatically based on project directory

# Application Settings
APP_NAME=360 Emlak

# Security (Production only)
# SESSION_COOKIE_SECURE=True

# File Upload
# MAX_CONTENT_LENGTH=16777216  # 16MB in bytes

# Logging
# LOG_LEVEL=INFO

# Email (Flask-Mail) - leave empty to disable email notifications
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@360emlak.com
